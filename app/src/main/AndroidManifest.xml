<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ELM327 over Bluetooth Classic (SPP) and BLE -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.bluetooth" android:required="true" />
    <!-- We support phones without a car head unit; AA is optional. -->
    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/ic_menu_compass"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TacomaTowMonitor">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Raw ELM327 console for proving what an adapter can and cannot do. -->
        <activity
            android:name=".DiagnosticsActivity"
            android:exported="false"
            android:label="Adapter diagnostics" />

        <!-- Read-only Toyota customize (C-BEST) discovery. No writes. -->
        <activity
            android:name=".CustomizeActivity"
            android:exported="false"
            android:label="Customize explorer" />

        <!-- Foreground OBD polling service keeps the ELM327 socket alive
             while towing, even with the screen off. -->
        <service
            android:name=".obd.ObdForegroundService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- ======== Android Auto (Car App Library) ========
             Category IOT is the closest supported fit for "dongle sensor
             readout", but Google does NOT offer a vehicle-health / OBD /
             custom-gauge category. Expect Play review to reject a public
             listing; this target is for YOUR truck via internal testing +
             the Desktop Head Unit (DHU). Full gauges stay on the phone;
             the car screen gets slow-refresh text rows only.
             See README "Android Auto — honest limits". -->
        <service
            android:name=".car.TacomaCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.IOT" />
            </intent-filter>
            <meta-data
                android:name="androidx.car.app.minCarApiLevel"
                android:value="${carAppMinCarApiLevel}" />
        </service>

        <meta-data
            android:name="androidx.car.app.metadata"
            android:resource="@xml/automotive_app_desc" />
    </application>
</manifest>
